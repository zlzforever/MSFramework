<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <MSFrameworkVersion>0.15.5-beta03</MSFrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="MSFramework" Version="$(MSFrameworkVersion)" />
    <PackageVersion Include="MSFramework.AspNetCore" Version="$(MSFrameworkVersion)" />
    <PackageVersion Include="MSFramework.Ef" Version="$(MSFrameworkVersion)" />
    <PackageVersion Include="MSFramework.Ef.MySql" Version="$(MSFrameworkVersion)" />
    <PackageVersion Include="MSFramework.Analyzers" Version="$(MSFrameworkVersion)" />
    <PackageVersion Include="MSFramework.Ef.Analyzers" Version="$(MSFrameworkVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Dapr.AspNetCore" Version="1.18.4" />
    <PackageVersion Include="Dapr.Client" Version="1.18.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
