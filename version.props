<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <AssemblyVersion>0.15.5.3</AssemblyVersion>
    <FileVersion>0.15.5.3</FileVersion>
    <!-- 给NuGet用的语义版本，带beta预发布后缀，这才是你对外发布的版本号 -->
    <PackageVersion>0.15.5-beta03</PackageVersion>
    <!-- 展示在dll属性详情里的友好版本，可带预发布标记 -->
    <InformationalVersion>0.15.5-beta03</InformationalVersion>
  </PropertyGroup>
</Project>